# Track personal configuration, not Herdr's generated interface or session data.
/*
!/.gitignore
!/README.md
!/settings.json
!/keys.json
!/programs.json
!/layouts/
!/mods/
!/themes/
!/fonts/
!/backgrounds/
!/my-icons/
!/integrations/
!/tests/
!/tools/

# Shipped layouts and themes are replaced by Herdr. Clone before editing.
/layouts/.state/
/layouts/main.json
/layouts/terminals.json
/layouts/win98.json
/layouts/win98.svg
/themes/atom-one-dark.json
/themes/win98.json

# Shipped mods are replaced by Herdr. Personal mods remain visible to Git.
/mods/agents/
/mods/changes/
/mods/confirm/
/mods/files/
/mods/help/
/mods/machine-add/
/mods/menu/
/mods/new-menu/
/mods/pane/
/mods/peek/
/mods/picker/
/mods/prompt/
/mods/spaces/
/mods/tabs/
/mods/terminals-bar/
/mods/terminals-pane/
/mods/toast/
/mods/win98/
/mods/workspace-chrome/
/mods/workspace-status/
/mods/worktree/

# Generated helpers, dependencies, editor artifacts and recovery files.
.DS_Store
node_modules/
/tools/review-backend/target/
jsconfig.json
*.d.ts
*.error
*.reset-*
*.old-*
